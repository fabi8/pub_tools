# Check if to show the banner
mode=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --show)
      mode=1
      ;;
  esac
  shift
done

# Common Paths

# plugins_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../plugins" && pwd)"
_this_repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd )"
export _this_repo_dir

_plugins_dir="$_this_repo_dir/plugins" 
mkdir -p $_plugins_dir
export _plugins_dir

_include_dir="$_this_repo_dir/include" 
export _include_dir

_2home_dir="$_this_repo_dir/2home" 
export _2home_dir

_2Profile_dir="$_this_repo_dir/2Profile" 
export _2Profile_dir

# Common Vars

_bash_config_start_tag="#START_BASH_CONFIG"
_bash_config_end_tag="#END_BASH_CONFIG"
_backup_extension=".gitbash.backup"

# Common Logger

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'
CYAN='\033[1;36m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
log_success() { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $*"; }

# Jokes

banner() {
echo -e "${CYAN}"
cat <<'EOF'
Loading...


     _   _           _                                 
    | \ | | ___  ___| |_ _ __ ___  _ __ ___   ___   
    |  \| |/ _ \/ __| __| '__/ _ \| '_ ` _ \ / _ \  
    | |\  | (_)/\__ \ |_| | | (_) | | | | | | (_) |   
    |_| \_|\___/|___/\__|_|  \___/|_| |_| |_|\___/   
---------------------------------------------------------
  USCSS NOSTROMO - LANDING SEQUENCE INITIATES ON 'MARK'
---------------------------------------------------------

EOF
echo -e "${NC}"
}

MARK() {
  clear
  banner

  steps=(
    "Initializing landing thrusters..."
    "Deploying landing gear..."
    "Scanning surface for safe zone..."
    "Adjusting descent vector..."
    "Stabilizing ship attitude..."
    "Final approach..."
    "Touchdown confirmed."
  )

  progress_bar() {
    local w=40
    local p=$1
    local f=$((p*w/100))
    printf "["
    for ((i=0;i<w;i++)); do
      [[ $i -lt $f ]] && printf "#" || printf " "
    done
    printf "] %3d%%\r" "$p"
  }

  for i in "${!steps[@]}"; do
    echo -e "${GREEN}${steps[$i]}${NC}"
    for p in $(seq 0 10 100); do
      progress_bar $p
      sleep 0.05
    done
    echo
    sleep 0.4
  done

  echo -e "${CYAN}\n--- NOSTROMO HAS LANDED. WELCOME TO LV-426. ---${NC}"
}

#################################################
# Print header

if [ "$mode" -eq 1 ]; then
  clear
  banner
  log_error "$(curl -s https://icanhazdadjoke.com/ -H "Accept: text/plain")"
fi


