set completion-ignore-case on
set show-all-if-ambiguous on

# Configure word boundaries to treat / as separator
$if Bash
    # Ctrl+Backspace - delete previous word (try multiple sequences)
    "\C-h": unix-filename-rubout
    
    # Ctrl+Up Arrow - insert "../" (parent directory)
    "\e[1;5A": "../"

    # Ctrl+Down Arrow - inserts "| vim -" to open the output in vim
    "\e[1;5B": " | vim -"

    # Ctrl+f - surounds the search querry (e.g. x*.cpp) with properly escaped command lsr
    "\C-f": "\C-alsr \"*\C-e*\""
$endif